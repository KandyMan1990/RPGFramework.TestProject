%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 35a53cab365904129b0d6ce4f53c6c89, type: 3}
  m_Name: VariableMap
  m_EditorClassIdentifier: RPGFramework.Core::RPGFramework.Core.Memory.VariableMapAsset
  m_Variables:
  - m_Name: CurrentModule
    m_Bank: 0
    m_Width: 2
    m_Count: 1
    m_Offset: 1
    m_Description: The module the playthrough is in. Its default is the module a new game begins in
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: CurrentField
    m_Bank: 0
    m_Width: 8
    m_Count: 1
    m_Offset: 8
    m_Description: The field the player is in. Its default is the field a new game begins in
    m_DefaultValue: 10519967275879140533
    m_ElementDefaults: []
  - m_Name: CurrentSpawn
    m_Bank: 0
    m_Width: 5
    m_Count: 1
    m_Offset: 16
    m_Description: The spawn point the player entered the current field by. Its default is where a new game begins
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: TestIntroCutscene
    m_Bank: 0
    m_Width: 0
    m_Count: 1
    m_Offset: 0
    m_Description: Triggers opening cutscene if unset
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: TestChoiceAnswer
    m_Bank: 1
    m_Width: 2
    m_Count: 1
    m_Offset: 6
    m_Description: Which answer the choice in TestField2 picked
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: PlayerPositionX
    m_Bank: 0
    m_Width: 9
    m_Count: 1
    m_Offset: 20
    m_Description: Where the player stood when the game was saved. Its default is not used
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: PlayerPositionY
    m_Bank: 0
    m_Width: 9
    m_Count: 1
    m_Offset: 24
    m_Description: Where the player stood when the game was saved. Its default is not used
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: PlayerPositionZ
    m_Bank: 0
    m_Width: 9
    m_Count: 1
    m_Offset: 28
    m_Description: Where the player stood when the game was saved. Its default is not used
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: PlayerFacing
    m_Bank: 0
    m_Width: 9
    m_Count: 1
    m_Offset: 32
    m_Description: Which way the player faced when the game was saved, in degrees around the field's up axis. Its default is not used
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: LoadedFromSave
    m_Bank: 1
    m_Width: 0
    m_Count: 1
    m_Offset: 7
    m_Description: Set when a save is loaded, and cleared once the player is back where it was made. Its default is not used
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: SaveEnabled
    m_Bank: 1
    m_Width: 0
    m_Count: 1
    m_Offset: 8
    m_Description: 'Whether the player can save from the party menu. Its default is the game''s policy: false to save only where a script allows it, true to save anywhere'
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: PlayTime
    m_Bank: 0
    m_Width: 6
    m_Count: 1
    m_Offset: 36
    m_Description: How long the playthrough has been played, in whole seconds. Counted by the framework
    m_DefaultValue: 0
    m_ElementDefaults: []
  - m_Name: LocationName
    m_Bank: 0
    m_Width: 8
    m_Count: 1
    m_Offset: 40
    m_Description: The place the player is in, as the hash of its localisation key. Written by the module the player is in
    m_DefaultValue: 0
    m_ElementDefaults: []
