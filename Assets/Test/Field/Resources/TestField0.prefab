  m_Dimension: 0
  m_Entities:
  - m_EntityId: 0
    m_Name: Entity0 (PlayMusic)
    m_Body: {fileID: 0}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'PLAY_MUSIC MusicSample Default

        RETURN'
      m_Slot: 0
  - m_EntityId: 1
    m_Name: Entity1 (PlaySound)
    m_Body: {fileID: 0}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'PLAY_SOUND Equip

        RETURN'
      m_Slot: 0
  - m_EntityId: 2
    m_Name: Entity2 (PlayerCharacter)
    m_Body: {fileID: 6354893702813436339}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'SET_PLAYER_ENTITY

        SET_BASE_ANIMATION IdleWalkRunBlend

        VISIBILITY true

        RETURN'
      m_Slot: 0
    - m_Type: 6
      m_Name: Anim
      m_Text: 'PLAY_ANIMATION_LOOPING InAir

        RETURN'
      m_Slot: 0
    - m_Type: 6
      m_Name: StopAnim
      m_Text: 'STOP_ANIMATION

        RETURN'
      m_Slot: 0
    - m_Type: 6
      m_Name: Move
      m_Text: 'MOVE_ENTITY_AND_WAIT -5 0 -5

        MOVE_ENTITY_TO_ENTITY_AND_WAIT 12 1

        RETURN'
      m_Slot: 0
    - m_Type: 6
      m_Name: Slide
      m_Text: 'SLIDE_ENTITY_AND_WAIT -5 0 0

        RETURN'
      m_Slot: 0
  - m_EntityId: 3
    m_Name: Entity3 (Gateway)
    m_Body: {fileID: 7445875409821500104}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 5
      m_Name: 
      m_Text: 'JUMP_TO_MAP TestField2 0

        RETURN'
      m_Slot: 0
  - m_EntityId: 4
    m_Name: Entity4 (GatewayActivation)
    m_Body: {fileID: 0}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'GATEWAY_TRIGGER_ACTIVATION true

        RETURN'
      m_Slot: 0
  - m_EntityId: 5
    m_Name: Entity5 (Interaction)
    m_Body: {fileID: 7497597249530857423}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'INTERACTION_TRIGGER_ACTIVATION true

        SET_INTERACTION_RANGE 2.0

        RETURN'
      m_Slot: 0
    - m_Type: 3
      m_Name: 
      m_Text: 'PLAY_SOUND ItemConsumed

        RETURN'
      m_Slot: 0
  - m_EntityId: 6
    m_Name: Entity6 (SetPosition & SetRotation)
    m_Body: {fileID: 5253742140373104738}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'VISIBILITY true

        RETURN'
      m_Slot: 0
    - m_Type: 1
      m_Name: 
      m_Text: 'LABEL Start

        SET_ENTITY_POSITION -2.0 2.0 0.0

        SET_ENTITY_ROTATION_OVER_TIME 0.0 90.0 0.0 0 2.0 0

        WAIT_SECONDS 2.0

        SET_ENTITY_POSITION -2.0 0.0 0.0

        SET_ENTITY_ROTATION_OVER_TIME 0.0 270.0 0.0 1 1.0 1

        WAIT_SECONDS 2.0

        GOTO_DIRECTLY Start

        RETURN'
      m_Slot: 0
  - m_EntityId: 7
    m_Name: Entity7 (FaceEntity)
    m_Body: {fileID: 2861220065097343795}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'VISIBILITY true

        RETURN'
      m_Slot: 0
    - m_Type: 1
      m_Name: 
      m_Text: 'LABEL Start

        SET_DIRECTION_TO_FACE_ENTITY 2

        WAIT_SECONDS 2.0

        GOTO_DIRECTLY Start

        RETURN'
      m_Slot: 0
  - m_EntityId: 8
    m_Name: Entity8 (MainMenuAccessibility)
    m_Body: {fileID: 0}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'MAIN_MENU_ACCESSIBILITY true

        RETURN'
      m_Slot: 0
  - m_EntityId: 9
    m_Name: Entity9 (CreateWindow)
    m_Body: {fileID: 0}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 1
      m_Name: 
      m_Text: "IF_BOOL $TestIntroCutscene == true\n    RETURN\nEND_IF\nSET_BOOL $TestIntroCutscene true\nWAIT_SECONDS 2\nCREATE_DIALOGUE_WINDOW 0 100 100 640 180\nSHOW_DIALOGUE_WINDOW 0 TestField/Test true\nRETURN"
      m_Slot: 0
  - m_EntityId: 10
    m_Name: Entity10 (Battle)
    m_Body: {fileID: 1287413900847595060}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'INTERACTION_TRIGGER_ACTIVATION true

        RETURN'
      m_Slot: 0
