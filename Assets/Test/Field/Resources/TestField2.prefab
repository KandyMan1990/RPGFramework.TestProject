  m_Name: 
  m_EditorClassIdentifier: RPGFramework.Field::RPGFramework.Field.FieldEntities
  m_Entities:
  - m_EntityId: 0
    m_Name: Entity0 (PlayMusic)
    m_Body: {fileID: 0}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'PLAY_MUSIC MusicSample Default

        RETURN'
  - m_EntityId: 1
    m_Name: Entity1 (PlayerCharacter)
    m_Body: {fileID: 6354893702813436339}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'SET_PLAYER_ENTITY

        VISIBILITY true

        RETURN'
    - m_Type: 1
      m_Name: 
      m_Text: 'LOCK_INPUT true

        WAIT_SECONDS 2.0

        LOCK_INPUT false

        RETURN'
  - m_EntityId: 2
    m_Name: Entity2 (AskPlayerChoice)
    m_Body: {fileID: 0}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
    - m_Type: 1
      m_Name: 
      m_Text: 'WAIT_SECONDS 3.0

        CREATE_DIALOGUE_WINDOW 0 100 100 506 300

        ASK_PLAYER_TO_MAKE_A_CHOICE $TestChoiceAnswer 0 TestField/Test TestField/Location Generic/Settings Generic/PlayerName

        RETURN'
  m_FormatVersion: 0
  m_Compiled: []
