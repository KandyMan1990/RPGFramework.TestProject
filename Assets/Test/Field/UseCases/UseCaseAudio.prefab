MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4226698957846357039}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 314535403b2949fba48cc97b81e469d3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: RPGFramework.Field::RPGFramework.Field.FieldEntities
  m_Dimension: 0
  m_Entities:
  - m_EntityId: 0
    m_Name: Player0
    m_Body: {fileID: 6354893702813436339}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'SET_PLAYER_ENTITY

        VISIBILITY true

        RETURN'
      m_Slot: 0
  - m_EntityId: 1
    m_Name: UseCaseMusicPlayed1
    m_Body: {fileID: 365186566660256512}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        RETURN'
      m_Slot: 0
  - m_EntityId: 2
    m_Name: UseCaseMusicState2
    m_Body: {fileID: 5173370342552446920}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        WAIT_SECONDS 0.5

        MUSIC_STEM_STATE UseCaseSong Both 0.5

        RETURN'
      m_Slot: 0
  - m_EntityId: 3
    m_Name: UseCaseMusicStopped3
    m_Body: {fileID: 6103353219984012425}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        IS_MUSIC_PLAYING $TestMusicPlaying

        WAIT_SECONDS 1

        STOP_MUSIC

        RETURN'
      m_Slot: 0
  - m_EntityId: 4
    m_Name: UseCaseMusicVolume4
    m_Body: {fileID: 3412219754922785211}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        SET_MUSIC_VOLUME 0.5

        RETURN'
      m_Slot: 0
  - m_EntityId: 5
    m_Name: UseCaseMusicFaded5
    m_Body: {fileID: 2312082635657907447}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        FADE_MUSIC_VOLUME 0.25 1

        WAIT_FOR_MUSIC_VOLUME

        ADD_MONEY 1

        RETURN'
      m_Slot: 0
  - m_EntityId: 6
    m_Name: UseCaseMusicFadedFrom6
    m_Body: {fileID: 1871067009707024577}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        FADE_MUSIC_VOLUME_FROM 0 0.75 1

        RETURN'
      m_Slot: 0
  - m_EntityId: 7
    m_Name: UseCaseCrossfade7
    m_Body: {fileID: 6215370870259986175}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_MUSIC UseCaseSong First

        WAIT_SECONDS 0.5

        CROSSFADE_MUSIC UseCaseSongTwo Default 1 1

        RETURN'
      m_Slot: 0
  - m_EntityId: 8
    m_Name: UseCaseBattleMusic8
    m_Body: {fileID: 4235764624963480708}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'SET_BATTLE_MUSIC UseCaseSongTwo

        RETURN'
      m_Slot: 0
  - m_EntityId: 9
    m_Name: UseCaseSoundPlayed9
    m_Body: {fileID: 4507588691801127140}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_SOUND UseCaseSound 0.5 -0.5 1

        RETURN'
      m_Slot: 0
  - m_EntityId: 10
    m_Name: UseCaseSoundStopped10
    m_Body: {fileID: 4782763333710418981}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_SOUND UseCaseSound 1 0 1

        WAIT_SECONDS 0.5

        STOP_SOUND 1

        RETURN'
      m_Slot: 0
  - m_EntityId: 11
    m_Name: UseCaseSoundFaded11
    m_Body: {fileID: 856374709312016610}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_SOUND UseCaseSound 1 0 1

        FADE_SOUND_VOLUME 1 0.2 0.5

        FADE_SOUND_PAN 1 0.8 0.5

        RETURN'
      m_Slot: 0
  - m_EntityId: 12
    m_Name: UseCaseAllSounds12
    m_Body: {fileID: 3567170037421170403}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_SOUND UseCaseSound 1 0 1

        SET_ALL_SOUND_VOLUME 0.5

        RETURN'
      m_Slot: 0
  - m_EntityId: 13
    m_Name: UseCaseAllSoundsFaded13
    m_Body: {fileID: 3268167502626442880}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'PLAY_SOUND UseCaseSound 1 0 1

        FADE_ALL_SOUND_VOLUME 0.25 0.5

        RETURN'
      m_Slot: 0
  - m_EntityId: 14
    m_Name: UseCaseReverb14
    m_Body: {fileID: 7178049372059537177}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: RETURN
      m_Slot: 0
    - m_Type: 3
      m_Name: Talk
      m_Text: 'SET_REVERB_PRESET 3

        SET_REVERB_VOLUME 0.5

        RETURN'
      m_Slot: 0
  - m_EntityId: 38
    m_Name: SoundLoop38
    m_Body: {fileID: 2010920030091997005}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'INTERACTION_TRIGGER_ACTIVATION true

        SET_INTERACTION_RANGE 2.0

        RETURN'
      m_Slot: 0
    - m_Type: 3
      m_Name: TryIt
      m_Text: 'PLAY_SOUND LoopTest 1 0 1

        WAIT_SECONDS 2.0

        FADE_SOUND_PAN 1 -1 1

        WAIT_SECONDS 2.0

        FADE_SOUND_PAN 1 1 1

        WAIT_SECONDS 2.0

        FADE_SOUND_PAN 1 0 0

        FADE_SOUND_VOLUME 1 0.2 1

        WAIT_SECONDS 2.0

        FADE_SOUND_VOLUME 1 1 1

        RETURN'
      m_Slot: 0
  - m_EntityId: 39
    m_Name: SoundStop39
    m_Body: {fileID: 8777685252599257798}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'INTERACTION_TRIGGER_ACTIVATION true

        SET_INTERACTION_RANGE 2.0

        RETURN'
      m_Slot: 0
    - m_Type: 3
      m_Name: TryIt
      m_Text: 'STOP_SOUND 1

        RETURN'
      m_Slot: 0
  - m_EntityId: 40
    m_Name: SoundAll40
    m_Body: {fileID: 270080820026732011}
    m_Scripts:
    - m_Type: 0
      m_Name: 
      m_Text: 'INTERACTION_TRIGGER_ACTIVATION true

        SET_INTERACTION_RANGE 2.0

        RETURN'
      m_Slot: 0
    - m_Type: 3
      m_Name: TryIt
      m_Text: 'FADE_ALL_SOUND_VOLUME 0 1

        WAIT_SECONDS 2.0

        FADE_ALL_SOUND_VOLUME 1 1

        RETURN'
      m_Slot: 0
  m_FormatVersion: 0
  m_Compiled: []
  m_AnimationNames: []
