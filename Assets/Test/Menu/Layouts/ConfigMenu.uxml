<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.rpgframework.core/Runtime/UI%20Toolkit/UIShared.uss?fileID=7433441132597879392&amp;guid=94d472c2b9a84d747912b7c0d4c5d053&amp;type=3#UIShared"/>
    <Style src="Menus.uss"/>
    <ui:VisualElement name="ConfigMenu" class="rpg-menu">
        <ui:VisualElement name="TitleContainer" class="rpg-menu-title-area">
            <ui:Label text="Config" name="TitleLabel" class="rpg-ui-label rpg-menu-title">
                <Bindings>
                    <RPGFramework.Localisation.StaticLocalisedText property="text" key="Generic/Settings"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="ContentContainer" class="rpg-menu-content">
            <ui:VisualElement name="ButtonsContainer" class="rpg-menu-buttons">
                <ui:VisualElement name="Language" class="rpg-menu-setting">
                    <RPGFramework.Core.UI.RPGUIButton focusable="true" name="LanguageBtn" text="Language">
                        <Bindings>
                            <RPGFramework.Localisation.StaticLocalisedText property="text" key="ConfigMenu/Language_Title"/>
                        </Bindings>
                    </RPGFramework.Core.UI.RPGUIButton>
                    <ui:Label text="Label" name="LanguageLabel" class="rpg-ui-label">
                        <Bindings>
                            <RPGFramework.Localisation.StaticLocalisedText property="text" key="ConfigMenu/Language"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
                <ui:VisualElement name="Controls">
                    <RPGFramework.Core.UI.RPGUIButton focusable="true" name="ControlsBtn" text="Controls">
                        <Bindings>
                            <RPGFramework.Localisation.StaticLocalisedText property="text" key="ConfigMenu/Controls"/>
                        </Bindings>
                    </RPGFramework.Core.UI.RPGUIButton>
                </ui:VisualElement>
                <ui:VisualElement name="MusicVolume" class="rpg-menu-setting">
                    <RPGFramework.Core.UI.RPGUIButton focusable="true" name="MusicVolumeBtn" text="Music Volume">
                        <Bindings>
                            <RPGFramework.Localisation.StaticLocalisedText property="text" key="ConfigMenu/Music_Volume"/>
                        </Bindings>
                    </RPGFramework.Core.UI.RPGUIButton>
                    <ui:Slider value="100" name="MusicVolumeSlider" class="rpg-menu-slider" fill="true" high-value="1"/>
                </ui:VisualElement>
                <ui:VisualElement name="SfxVolume" class="rpg-menu-setting">
                    <RPGFramework.Core.UI.RPGUIButton focusable="true" name="SfxVolumeBtn" text="Sfx Volume">
                        <Bindings>
                            <RPGFramework.Localisation.StaticLocalisedText property="text" key="ConfigMenu/Sfx_Volume"/>
                        </Bindings>
                    </RPGFramework.Core.UI.RPGUIButton>
                    <ui:Slider value="100" name="SfxVolumeSlider" class="rpg-menu-slider" fill="true" high-value="1"/>
                </ui:VisualElement>
                <ui:VisualElement name="BattleMessageSpeed" class="rpg-menu-setting">
                    <RPGFramework.Core.UI.RPGUIButton focusable="true" name="BattleMessageSpeedBtn" text="Battle Message Speed">
                        <Bindings>
                            <RPGFramework.Localisation.StaticLocalisedText property="text" key="ConfigMenu/Battle_Message_Speed"/>
                        </Bindings>
                    </RPGFramework.Core.UI.RPGUIButton>
                    <ui:Slider value="100" name="BattleMessageSpeedSlider" class="rpg-menu-slider" fill="true" high-value="1"/>
                </ui:VisualElement>
                <ui:VisualElement name="FieldMessageSpeed" class="rpg-menu-setting">
                    <RPGFramework.Core.UI.RPGUIButton focusable="true" name="FieldMessageSpeedBtn" text="Field Message Speed">
                        <Bindings>
                            <RPGFramework.Localisation.StaticLocalisedText property="text" key="ConfigMenu/Field_Message_Speed"/>
                        </Bindings>
                    </RPGFramework.Core.UI.RPGUIButton>
                    <ui:Slider value="100" name="FieldMessageSpeedSlider" class="rpg-menu-slider" fill="true" high-value="1"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FooterContainer" class="rpg-menu-footer"/>
    </ui:VisualElement>
</ui:UXML>
