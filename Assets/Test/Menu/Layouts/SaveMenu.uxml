<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.rpgframework.core/Runtime/UI%20Toolkit/UIShared.uss?fileID=7433441132597879392&amp;guid=94d472c2b9a84d747912b7c0d4c5d053&amp;type=3#UIShared"/>
    <Style src="Menus.uss"/>
    <ui:VisualElement name="SaveMenu" class="rpg-menu">
        <ui:VisualElement name="TitleContainer" class="rpg-menu-title-area">
            <ui:Label text="Save" name="SaveTitleLabel" class="rpg-ui-label rpg-menu-title">
                <Bindings>
                    <RPGFramework.Localisation.LocalisedText property="text" key="SaveMenu/Save_Title"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="Load" name="LoadTitleLabel" class="rpg-ui-label rpg-menu-title">
                <Bindings>
                    <RPGFramework.Localisation.LocalisedText property="text" key="SaveMenu/Load_Title"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:ScrollView name="SlotsScrollView">
            <RPGFramework.Core.UI.RPGUIButton focusable="true" name="NewSaveBtn" text="New Save">
                <Bindings>
                    <RPGFramework.Localisation.LocalisedText property="text" key="SaveMenu/New_Save"/>
                </Bindings>
            </RPGFramework.Core.UI.RPGUIButton>
        </ui:ScrollView>
        <ui:VisualElement name="QuestionPanel">
            <ui:Label text="Overwrite?" name="OverwriteQuestionLabel" class="rpg-ui-label">
                <Bindings>
                    <RPGFramework.Localisation.LocalisedText property="text" key="SaveMenu/Overwrite_Question"/>
                </Bindings>
            </ui:Label>
            <ui:Label text="Delete?" name="DeleteQuestionLabel" class="rpg-ui-label">
                <Bindings>
                    <RPGFramework.Localisation.LocalisedText property="text" key="SaveMenu/Delete_Question"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement name="QuestionButtons">
                <RPGFramework.Core.UI.RPGUIButton focusable="true" name="YesBtn" text="Yes">
                    <Bindings>
                        <RPGFramework.Localisation.LocalisedText property="text" key="Generic/Yes"/>
                    </Bindings>
                </RPGFramework.Core.UI.RPGUIButton>
                <RPGFramework.Core.UI.RPGUIButton focusable="true" name="NoBtn" text="No">
                    <Bindings>
                        <RPGFramework.Localisation.LocalisedText property="text" key="Generic/No"/>
                    </Bindings>
                </RPGFramework.Core.UI.RPGUIButton>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
