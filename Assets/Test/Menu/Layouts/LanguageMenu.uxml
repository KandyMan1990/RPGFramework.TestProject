<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Packages/com.rpgframework.core/Runtime/UI%20Toolkit/UIShared.uss?fileID=7433441132597879392&amp;guid=94d472c2b9a84d747912b7c0d4c5d053&amp;type=3#UIShared"/>
    <Style src="Menus.uss"/>
    <ui:VisualElement name="LanguageMenu" class="rpg-menu">
        <ui:VisualElement name="TitleContainer" class="rpg-menu-title-area">
            <ui:Label text="Language" name="TitleLabel" class="rpg-ui-label rpg-menu-title">
                <Bindings>
                    <RPGFramework.Localisation.LocalisedText property="text" key="ConfigMenu/Language_Title"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="ContentContainer" class="rpg-menu-content">
            <ui:VisualElement name="ButtonsContainer" class="rpg-menu-buttons">
                <ui:VisualElement name="Language" class="rpg-menu-setting">
                    <RPGFramework.Core.UI.RPGUIButton focusable="true" name="LanguageBtn" text="Language">
                        <Bindings>
                            <RPGFramework.Localisation.LocalisedText property="text" key="ConfigMenu/Language"/>
                        </Bindings>
                    </RPGFramework.Core.UI.RPGUIButton>
                    <ui:Label text="Label" name="LanguageLabel" class="rpg-ui-label">
                        <Bindings>
                            <RPGFramework.Localisation.LocalisedText property="text" key="ConfigMenu/Language"/>
                        </Bindings>
                    </ui:Label>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FooterContainer" class="rpg-menu-footer"/>
    </ui:VisualElement>
</ui:UXML>
